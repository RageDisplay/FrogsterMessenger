<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows build fetches one NuGet package (WIL, for audioplayers_windows).
  Naming the source here keeps the build from depending on whatever the
  machine's own NuGet configuration has, or lacks.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
