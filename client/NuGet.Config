<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows plugins may fetch NuGet packages while building. Naming the source
  here keeps the build from depending on whatever the machine's own NuGet
  configuration has, or lacks: a fresh clone builds the same everywhere.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
